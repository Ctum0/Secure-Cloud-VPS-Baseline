# ── Docker / stack configuration ──────────────────────────────────────────────
# Portainer admin password (plaintext, used only to generate the hash below)
PORTAINER_PASSWORD=ChangeMe123!

# bcrypt hash of PORTAINER_PASSWORD, passed to Portainer via --admin-password
# on first startup. MUST be filled in or Portainer will refuse to start.
# Generate with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin ChangeMe123!
PORTAINER_ADMIN_PASSWORD_HASH=

# Homarr secret encryption key. Generate with:
#   openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=ChangeMe123!

# ── Host configuration ────────────────────────────────────────────────────────
# Backup destination directory (used by scripts/backup.sh)
BACKUP_DIR=./backups
