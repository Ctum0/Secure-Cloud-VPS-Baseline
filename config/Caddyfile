# Caddyfile — reverse proxy with automatic HTTPS via Let's Encrypt.
#
# Replace yourdomain.com with your real domain and make sure the A/AAAA
# records point to this server's public IP.

yourdomain.com {
        root * /usr/share/caddy
        file_server
}

portainer.yourdomain.com {
        reverse_proxy localhost:9000
}

home.yourdomain.com {
        reverse_proxy localhost:7575
}

metrics.yourdomain.com {
        reverse_proxy localhost:3001
}

n8n.yourdomain.com {
        reverse_proxy localhost:5678
}

hermes.yourdomain.com {
        reverse_proxy localhost:9119
}

wazuh.yourdomain.com {
        reverse_proxy https://localhost:8443 {
                transport http {
                        tls_insecure_skip_verify
                }
        }
}
